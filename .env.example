# Copier en .env.local pour changer une valeur ; sans fichier, ces valeurs
# par defaut visent la pile Docker Compose de e-commerce-BACK.

# Keycloak : l'adresse publique, sans /realms/... (ajoute par l'application).
# Une valeur qui commence par « / » est un chemin sur l'hote du back-office :
# l'image deployee est construite avec /auth (et / pour la gateway).
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=ecommerce
VITE_KEYCLOAK_CLIENT_ID=web-bo

# La gateway : toutes les API passent par elle.
VITE_API_URL=http://localhost:8080
